{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dumplyzer",
  "version": "0.1.0",
  "identifier": "com.dumplyzer.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "",
        "url": "splash.html",
        "width": 688,
        "height": 384,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "center": true,
        "fullscreen": false,
        "focus": true,
        "visible": true,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "label": "main",
        "title": "Dumplyzer",
        "width": 960,
        "height": 640,
        "minWidth": 900,
        "minHeight": 640,
        "maximized": true,
        "theme": "Light",
        "resizable": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Dumplyzer",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Volatility 3 memory forensics workbench",
    "longDescription": "Dumplyzer is an offline desktop workbench for Volatility 3 memory forensics. The analysis engine is a bundled Python 3.12 runtime with yara-python 4.5.4. bulk_extractor 2.2.0, Mandiant CAPA 9.4.0, and Mandiant FLOSS 3.1.1 are bundled as separate programs. PE Extraction reconstructs EXE/DLL artifacts from memory dumps.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/runtime",
      "resources/tools",
      "resources/rules"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "../../packaging/windows/nsis/installer.nsi"
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "a7349549-6d10-4b69-90e4-b7523e941030"
      }
    }
  }
}
